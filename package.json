{
  "name": "maya-link",
  "displayName": "Maya link",
  "publisher": "IvanCuenca",
  "description": "Connect to different Maya instances from VS Code using maya.cmds.commandPort",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "maya",
    "autodesk",
    "commandPort",
    "pipeline",
    "animation"
  ],
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivan-cuenca-dev/maya-link.git"
  },
  "bugs": {
    "url": "https://github.com/ivan-cuenca-dev/maya-link/issues"
  },
  "homepage": "https://github.com/ivan-cuenca-dev/maya-link#readme",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Maya link",
      "properties": {
        "mayaLink.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write verbose diagnostics to the Maya link output channel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mayaLink",
          "title": "Maya link",
          "icon": "/media/logo.svg"
        }
      ]
    },
    "views": {
      "mayaLink": [
        {
          "type": "webview",
          "id": "mayaLink.panel",
          "name": "instances"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mayaLink.refresh",
          "when": "view == mayaLink.panel",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "mayaLink.refresh",
        "title": "Refresh",
        "category": "Maya link",
        "icon": "$(refresh)"
      },
      {
        "command": "mayaLink.sendCode",
        "category": "Maya link",
        "title": "Send Python to Maya"
      },
      {
        "command": "mayaLink.copySetup",
        "category": "Maya link",
        "title": "Copy Setup Script"
      },
      {
        "command": "mayaLink.showSetup",
        "category": "Maya link",
        "title": "Show Setup Script"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "~1.75.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
